# Optional: direct prompt-to-script in the web studio/CLI. Claude MCP needs no API key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional paid narration. Select ElevenLabs in the studio, or pass --elevenlabs / provider=elevenlabs.
# Voice ID from https://elevenlabs.io/app/voice-library — if omitted, a Hindi/Indian-labelled voice is chosen, else the first premade voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# For turbo/flash models only; ignored by eleven_multilingual_v2.
# ELEVENLABS_LANGUAGE=hi
# Local tools already installed on this machine. Absolute paths also work.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
POWERSHELL_PATH=pwsh.exe
PORT=3210
OLLAMA_MODEL=qwen3:8b
# Optional free online speech, opt-in via provider=edge. Sends narration to Microsoft's service.
# VOICE_PYTHON defaults to this project's .venv Python; override when needed.
VOICE_PYTHON=
EDGE_VOICE=hi-IN-MadhurNeural
EDGE_RATE=+8%
