{
  "name": "movie-idiots-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prompt-driven movie review and revisit video toolchain with Remotion, FFmpeg and MCP",
  "scripts": {
    "dev": "tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "studio": "remotion studio src/video/index.tsx",
    "video": "tsx src/cli.ts",
    "doctor": "tsx src/cli.ts doctor",
    "demo": "tsx src/cli.ts demo",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "short": "tsx scripts/short.ts",
    "studio:shorts": "remotion studio src/collage/index.tsx"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.532",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
